# ============================================================
# ParcelPilot AI Support — environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# --- Google Gemini LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- LLM provider selection (currently only "gemini" is supported) ---
LLM_PROVIDER=gemini
